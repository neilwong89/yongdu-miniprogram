<!-- 添加成本页 - 设计稿还原 -->
<view class="page">

  <!-- 主内容（可滚动） -->
  <scroll-view class="form-scroll" scroll-y>
    <view class="form-content">

      <!-- 顶部导航 -->
      <view class="form-header">
        <view class="back-btn" bindtap="goBack">
          <text class="back-icon">←</text>
        </view>
        <view class="header-center">
          <text class="header-sub">记录一件拥有</text>
          <text class="header-title">{{isEdit ? '编辑成本' : '添加成本'}}</text>
        </view>
        <view class="w-9"></view>
      </view>

      <!-- 图片上传区 -->
      <view class="photo-upload">
        <view class="upload-icon-wrap">
          <text class="upload-icon">📷</text>
        </view>
        <view class="upload-text">
          <text class="upload-title">放一张物品照片</text>
          <text class="upload-sub">让它在日后更容易被记起</text>
        </view>
      </view>

      <!-- 表单区 -->
      <view class="form-sections">

        <!-- 名称 -->
        <view class="field-row">
          <view class="field-label">名称</view>
          <input
            class="field-input"
            placeholder="例如：新买的书桌灯"
            maxlength="20"
            value="{{name}}"
            bindinput="onNameInput"
          />
        </view>

        <!-- 类别 + 状态（双列） -->
        <view class="field-row cols-2">
          <view class="field-group">
            <view class="field-label">类别</view>
            <view class="field-select" bindtap="onCategoryTap">
              <text class="field-select-val">{{categoryName}}</text>
              <text class="field-arrow">›</text>
            </view>
          </view>
          <view class="field-group">
            <view class="field-label">状态</view>
            <view class="field-select" bindtap="onStatusTap">
              <text class="field-select-val">{{statusLabel}}</text>
              <text class="field-arrow">›</text>
            </view>
          </view>
        </view>

        <!-- 购买价格 + 日期（双列） -->
        <view class="field-row cols-2">
          <view class="field-group">
            <view class="field-label">购买价格</view>
            <input
              class="field-input"
              type="digit"
              placeholder="0.00"
              value="{{price}}"
              bindinput="onPriceInput"
            />
          </view>
          <view class="field-group">
            <view class="field-label">购买日期</view>
            <picker mode="date" value="{{purchaseDate}}" bindchange="onPurchaseDateChange">
              <view class="field-select">
                <text class="field-select-val">{{purchaseDate}}</text>
                <text class="field-arrow">›</text>
              </view>
            </picker>
          </view>
        </view>

        <!-- 成本计算方式 -->
        <view class="method-card">
          <view class="method-title">成本计算方式</view>
          <view class="method-btns">
            <view
              class="method-btn {{unit === 'day' ? 'active' : ''}}"
              bindtap="onUnitChange"
              data-unit="day"
            >按天分摊</view>
            <view
              class="method-btn {{unit === 'count' ? 'active' : ''}}"
              bindtap="onUnitChange"
              data-unit="count"
            >按次使用</view>
          </view>
          <text class="method-hint">{{unit === 'day' ? '从购买日起，价格按实际经过天数分摊；可填写预期使用时长。' : '总价 ÷ 累计使用次数 = 本次成本；首页可随时为它增加一次使用。'}}</text>
        </view>

        <!-- 预期使用时长（按天时显示） -->
        <view class="field-row" wx:if="{{unit === 'day'}}">
          <view class="field-label">预期使用时长（天）</view>
          <input
            class="field-input"
            type="number"
            placeholder="例如：1095"
            value="{{expectedDays}}"
            bindinput="onExpectedDaysInput"
          />
        </view>

        <!-- 备注 -->
        <view class="field-row">
          <view class="field-label">备注</view>
          <textarea
            class="field-textarea"
            placeholder="购买缘由、使用感受或想记下的话"
            maxlength="200"
            value="{{remark}}"
            bindinput="onRemarkInput"
          />
        </view>

        <!-- 卖出信息（已卖出状态） -->
        <view class="field-row" wx:if="{{status === 'retired'}}">
          <view class="field-label">卖出价格（元）</view>
          <input
            class="field-input"
            type="digit"
            placeholder="可选"
            value="{{soldPrice}}"
            bindinput="onSoldPriceInput"
          />
        </view>

      </view>

    </view>
  </scroll-view>

  <!-- 底部保存按钮 -->
  <view class="bottom-bar">
    <view class="save-btn" bindtap="onSave">添加成本</view>
  </view>

</view>

<!-- 分类选择器弹层 -->
<view class="picker-mask" wx:if="{{showCategoryPicker}}" bindtap="onCategoryPickerCancel">
  <view class="picker-sheet" catchtap="noop">
    <picker-view
      indicator-class="picker-indicator"
      bindchange="onCategoryPickerChange"
    >
      <picker-view-column>
        <view wx:for="{{categoryList}}" wx:key="id" class="picker-item">{{item.name}}</view>
      </picker-view-column>
    </picker-view>
    <view class="picker-cancel" bindtap="onCategoryPickerCancel">取消</view>
  </view>
</view>

<!-- 状态选择器弹层 -->
<view class="picker-mask" wx:if="{{showStatusPicker}}" bindtap="onStatusPickerCancel">
  <view class="picker-sheet" catchtap="noop">
    <picker-view
      indicator-class="picker-indicator"
      bindchange="onStatusPickerChange"
    >
      <picker-view-column>
        <view wx:for="{{statusOptions}}" wx:key="value" class="picker-item">{{item.label}}</view>
      </picker-view-column>
    </picker-view>
    <view class="picker-cancel" bindtap="onStatusPickerCancel">取消</view>
  </view>
</view>

<!-- 自定义分类输入弹窗 -->
<view class="mask" wx:if="{{showCustomCategoryInput}}" bindtap="onCustomCategoryCancel">
  <view class="dialog" catchtap="noop">
    <view class="dialog-title">自定义分类</view>
    <input
      class="dialog-input"
      placeholder="请输入分类名称（最多10字）"
      maxlength="10"
      focus="{{true}}"
      value="{{customCategoryName}}"
      bindinput="onCustomCategoryInput"
    />
    <view class="dialog-btns">
      <view class="dialog-btn cancel" bindtap="onCustomCategoryCancel">取消</view>
      <view class="dialog-btn confirm" bindtap="onCustomCategoryConfirm">确定</view>
    </view>
  </view>
</view>
