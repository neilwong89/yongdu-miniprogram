/* 添加成本页 - 设计稿还原 WXSS */

page {
  background: #edf0e9;
}

/* === 页面框架 === */
.page {
  min-height: 100vh;
  background: #edf0e9;
  display: flex;
  flex-direction: column;
}

.form-scroll {
  flex: 1;
  background: #fbfaf6;
}

.form-content {
  padding: 0 40rpx 200rpx;
}

/* === 顶部导航 === */
.form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
}

.back-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef1eb;
  border-radius: 50%;
}

.back-icon {
  font-size: 32rpx;
  color: #32423b;
}

.header-center {
  text-align: center;
}

.header-sub {
  font-size: 22rpx;
  color: #8b968f;
  letter-spacing: 3rpx;
  display: block;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #32423b;
  display: block;
  margin-top: 4rpx;
}

.w-9 {
  width: 72rpx;
}

/* === 图片上传区 === */
.photo-upload {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #f0f5ef;
  border: 3rpx dashed #b8c9ba;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 36rpx;
}

.upload-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  background: #dceadf;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.upload-icon {
  font-size: 48rpx;
}

.upload-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.upload-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #32423b;
}

.upload-sub {
  font-size: 24rpx;
  color: #7b897f;
}

/* === 表单区 === */
.form-sections {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.field-row {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0ede8;
}

.field-row.cols-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.field-group {
  display: flex;
  flex-direction: column;
}

.field-label {
  font-size: 24rpx;
  color: #8b968f;
  margin-bottom: 14rpx;
  letter-spacing: 1rpx;
}

.field-input {
  background: #f0f2ec;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  font-size: 30rpx;
  color: #32423b;
  width: 100%;
  box-sizing: border-box;
}

.field-input::placeholder {
  color: #9da79f;
}

.field-textarea {
  background: #f0f2ec;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  color: #32423b;
  width: 100%;
  box-sizing: border-box;
  min-height: 140rpx;
}

.field-textarea::placeholder {
  color: #9da79f;
}

.field-select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f0f2ec;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
}

.field-select-val {
  font-size: 30rpx;
  color: #32423b;
}

.field-arrow {
  font-size: 32rpx;
  color: #9da79f;
}

/* === 成本计算方式卡片 === */
.method-card {
  background: #e6eee7;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 28rpx 0;
}

.method-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #32423b;
}

.method-btns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 20rpx;
}

.method-btn {
  padding: 22rpx;
  background: #ffffff;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #32423b;
  text-align: center;
  transition: all 0.2s;
}

.method-btn.active {
  background: #466957;
  color: #ffffff;
}

.method-hint {
  font-size: 22rpx;
  color: #668070;
  display: block;
  margin-top: 18rpx;
  line-height: 1.6;
}

/* === 底部保存按钮 === */
.bottom-bar {
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fbfaf6;
  border-top: 1.5rpx solid #e8ebe4;
}

.save-btn {
  background: #466957;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 20rpx;
  letter-spacing: 1rpx;
}

/* === 选择器弹层 === */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(50, 66, 59, 0.3);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.picker-sheet {
  width: 100%;
  background: #fbfaf6;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 0 60rpx;
}

.picker-indicator {
  height: 80rpx;
  line-height: 80rpx;
}

.picker-item {
  text-align: center;
  line-height: 80rpx;
  font-size: 30rpx;
  color: #32423b;
}

.picker-cancel {
  text-align: center;
  color: #7a887f;
  font-size: 30rpx;
  padding: 24rpx;
}

/* === 自定义分类弹窗 === */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(50, 66, 59, 0.3);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog {
  width: 560rpx;
  background: #fbfaf6;
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 36rpx;
  color: #32423b;
}

.dialog-input {
  background: #f0f2ec;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  font-size: 30rpx;
  color: #32423b;
  margin-bottom: 36rpx;
  width: 100%;
  box-sizing: border-box;
}

.dialog-input::placeholder {
  color: #9da79f;
}

.dialog-btns {
  display: flex;
  gap: 20rpx;
}

.dialog-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 100rpx;
  font-size: 30rpx;
}

.dialog-btn.cancel {
  background: #ffffff;
  border: 1.5rpx solid #e8ebe4;
  color: #7a887f;
}

.dialog-btn.confirm {
  background: #466957;
  color: #ffffff;
}
