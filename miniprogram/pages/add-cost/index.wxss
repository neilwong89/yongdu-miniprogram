/* add-cost 页面样式 */
.page {
  padding: 24rpx;
  padding-bottom: 120rpx;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.required {
  color: #e64340;
  margin-left: 4rpx;
}

/* emoji 选择 */
.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.emoji-item {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  border: 2rpx solid transparent;
}

.emoji-item.active {
  background: #e8f4ff;
  border-color: #1aad19;
}

/* 输入框 */
.input {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  width: 100%;
  box-sizing: border-box;
}

/* picker 行 */
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.picker-row .label {
  font-size: 30rpx;
  color: #333;
}

.picker-row .right {
  display: flex;
  align-items: center;
}

.picker-value {
  font-size: 30rpx;
  color: #333;
}

.arrow {
  font-size: 32rpx;
  color: #999;
  margin-left: 8rpx;
}

/* radio */
.radio-item {
  display: inline-flex;
  align-items: center;
  margin-right: 40rpx;
  font-size: 30rpx;
}

.radio-item radio {
  margin-right: 8rpx;
}

/* textarea */
.textarea {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
}

/* 保存按钮 */
.btn-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.btn-primary {
  background: #1aad19;
  color: #fff;
  font-size: 32rpx;
  border-radius: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
}

/* 辅助类 */
.mt16 {
  margin-top: 16rpx;
}

/* picker 弹层 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.picker-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 0;
}

.picker-indicator {
  height: 80rpx;
  line-height: 80rpx;
}

.picker-item {
  text-align: center;
  line-height: 80rpx;
  font-size: 30rpx;
}

.picker-cancel {
  text-align: center;
  color: #999;
  font-size: 30rpx;
  margin-top: 16rpx;
  padding: 20rpx;
}

/* 自定义分类弹窗 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog {
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 32rpx;
}

.dialog-input {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  margin-bottom: 32rpx;
}

.dialog-btns {
  display: flex;
  gap: 24rpx;
}

.dialog-btn {
  flex: 1;
  font-size: 30rpx;
  border-radius: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.dialog-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.dialog-btn.confirm {
  background: #1aad19;
  color: #fff;
}
