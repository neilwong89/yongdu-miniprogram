/* add-cost 页面样式 - 清新淡雅 */
page {
  background: #f5f3ef;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.page {
  padding: 32rpx 40rpx 140rpx;
  background: #f5f3ef;
}

.section {
  margin-bottom: 36rpx;
}

.section-title {
  font-size: 26rpx;
  color: #9e9a93;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

.required {
  color: #c06050;
  margin-left: 4rpx;
}

/* emoji 选择 */
.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.emoji-item {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1.5rpx solid #e4e0d8;
  transition: border-color 0.2s, background 0.2s;
}

.emoji-item.active {
  background: #e8f2e8;
  border-color: #6b7c5e;
}

/* 输入框 */
.input {
  background: #ffffff;
  border: 1.5rpx solid #e4e0d8;
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
  font-size: 30rpx;
  color: #2d3436;
  width: 100%;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.input:focus {
  border-color: #a8c5a8;
}

.input::placeholder {
  color: #c5c0b6;
}

/* picker 行 */
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border: 1.5rpx solid #e4e0d8;
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
  transition: border-color 0.2s;
}

.picker-row .label {
  font-size: 30rpx;
  color: #2d3436;
}

.picker-row .right {
  display: flex;
  align-items: center;
}

.picker-value {
  font-size: 30rpx;
  color: #2d3436;
}

.arrow {
  font-size: 32rpx;
  color: #c5c0b6;
  margin-left: 8rpx;
}

/* radio */
radio-group {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
}

.radio-item {
  display: inline-flex;
  align-items: center;
  font-size: 30rpx;
  color: #4a4540;
  padding: 12rpx 24rpx;
  background: #ffffff;
  border: 1.5rpx solid #e4e0d8;
  border-radius: 100rpx;
  transition: all 0.2s;
}

.radio-item radio {
  margin-right: 10rpx;
  transform: scale(0.85);
}

.radio-item[aria-checked="true"] {
  background: #e8f2e8;
  border-color: #6b7c5e;
  color: #4a5a3a;
}

/* textarea */
.textarea {
  background: #ffffff;
  border: 1.5rpx solid #e4e0d8;
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
  font-size: 30rpx;
  color: #2d3436;
  width: 100%;
  box-sizing: border-box;
  min-height: 160rpx;
  transition: border-color 0.2s;
}

.textarea:focus {
  border-color: #a8c5a8;
}

.textarea::placeholder {
  color: #c5c0b6;
}

/* 保存按钮 */
.btn-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #f5f3ef;
  border-top: 1.5rpx solid #e4e0d8;
}

.btn-primary {
  background: #6b7c5e;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 100rpx;
  height: 96rpx;
  line-height: 96rpx;
  letter-spacing: 1rpx;
}

/* 辅助类 */
.mt16 {
  margin-top: 16rpx;
}

/* picker 弹层 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(45, 52, 54, 0.25);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.picker-sheet {
  width: 100%;
  background: #faf8f4;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 0 60rpx;
}

.picker-indicator {
  height: 80rpx;
  line-height: 80rpx;
}

.picker-item {
  text-align: center;
  line-height: 80rpx;
  font-size: 30rpx;
  color: #4a4540;
}

.picker-cancel {
  text-align: center;
  color: #9e9a93;
  font-size: 30rpx;
  margin-top: 16rpx;
  padding: 24rpx;
}

/* 自定义分类弹窗 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(45, 52, 54, 0.25);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog {
  width: 560rpx;
  background: #faf8f4;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 40rpx;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 36rpx;
  color: #2d3436;
}

.dialog-input {
  background: #ffffff;
  border: 1.5rpx solid #e4e0d8;
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
  font-size: 30rpx;
  margin-bottom: 36rpx;
  color: #2d3436;
}

.dialog-input:focus {
  border-color: #a8c5a8;
}

.dialog-btns {
  display: flex;
  gap: 20rpx;
}

.dialog-btn {
  flex: 1;
  font-size: 30rpx;
  border-radius: 100rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.dialog-btn.cancel {
  background: #ffffff;
  border: 1.5rpx solid #e4e0d8;
  color: #7a756c;
}

.dialog-btn.confirm {
  background: #6b7c5e;
  color: #fff;
}
