/* 洞察页样式 - 清新淡雅 */
page {
  background: #f5f3ef;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

/* === 页面基础 === */
.page {
  min-height: 100vh;
  background: #f5f3ef;
  padding-bottom: calc(88rpx + env(safe-area-inset-bottom));
}

/* === 自定义导航栏 === */
.nav-bar {
  background: #f5f3ef;
  padding: 0 40rpx 20rpx;
}

.nav-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #2d3436;
  letter-spacing: -1rpx;
}

/* === Section 通用 === */
.section {
  margin: 0 40rpx 28rpx;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2d3436;
}

.section-sub {
  font-size: 22rpx;
  color: #9e9a93;
}

/* === 顶部统计卡片 === */
.stat-cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.stat-card {
  background: #ffffff;
  border: 1.5rpx solid #e4e0d8;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  position: relative;
  overflow: hidden;
}

.stat-card-primary {
  background: #6b7c5e;
  border-color: #6b7c5e;
}

.stat-label {
  font-size: 22rpx;
  color: #9e9a93;
  margin-bottom: 10rpx;
  letter-spacing: 0.5rpx;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #2d3436;
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.stat-card-primary .stat-label {
  color: rgba(255,255,255,0.7);
}

.stat-card-primary .stat-value {
  color: #ffffff;
}

.stat-sub {
  font-size: 20rpx;
  color: #9e9a93;
  margin-top: 8rpx;
}

.stat-card-primary .stat-sub {
  color: rgba(255,255,255,0.65);
}

/* === 成本分布 === */
.category-list {
  background: #ffffff;
  border: 1.5rpx solid #e4e0d8;
  border-radius: 24rpx;
  overflow: hidden;
}

.category-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid #f0ede8;
}

.category-item:last-child {
  border-bottom: none;
}

.cat-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
}

.cat-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.cat-info {
  min-width: 0;
}

.cat-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d3436;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cat-meta {
  font-size: 22rpx;
  color: #9e9a93;
  margin-top: 4rpx;
}

.cat-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
  margin-left: 20rpx;
}

.cat-cost {
  font-size: 28rpx;
  font-weight: 700;
  color: #6b7c5e;
}

.cat-bar-wrap {
  width: 120rpx;
  height: 6rpx;
  background: #f0ede8;
  border-radius: 3rpx;
  overflow: hidden;
}

.cat-bar {
  height: 100%;
  background: #6b7c5e;
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

/* === 成本排行 === */
.ranking-list {
  background: #ffffff;
  border: 1.5rpx solid #e4e0d8;
  border-radius: 24rpx;
  overflow: hidden;
}

.rank-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid #f0ede8;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
}

.rank-badge {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
  background: #6b7c5e;
}

.rank-badge.top {
  background: #b08050;
}

.rank-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.rank-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d3436;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rank-right {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.rank-cost {
  font-size: 32rpx;
  font-weight: 700;
  color: #6b7c5e;
}

.rank-unit {
  font-size: 20rpx;
  color: #9e9a93;
}

/* === 低效率物品 === */
.warning-title {
  color: #b05a3a;
}

.warn-list {
  background: #ffffff;
  border: 1.5rpx solid #e4e0d8;
  border-radius: 24rpx;
  overflow: hidden;
}

.warn-item {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid #f0ede8;
  gap: 18rpx;
}

.warn-item:last-child {
  border-bottom: none;
}

.warn-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.warn-info {
  flex: 1;
  min-width: 0;
}

.warn-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d3436;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.warn-reason {
  font-size: 22rpx;
  color: #b05a3a;
  margin-top: 4rpx;
}

.warn-arrow {
  font-size: 36rpx;
  color: #c5c0b6;
  flex-shrink: 0;
}

/* === 底部留空 === */
.bottom-spacer {
  height: 32rpx;
}

/* === 空状态 === */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
  gap: 20rpx;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.45;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #4a4540;
}

.empty-desc {
  font-size: 28rpx;
  color: #9e9a93;
  text-align: center;
}

.empty-btn {
  margin-top: 12rpx;
  padding: 22rpx 64rpx;
  background: #6b7c5e;
  color: #fff;
  border-radius: 100rpx;
  font-size: 30rpx;
  font-weight: 600;
}
