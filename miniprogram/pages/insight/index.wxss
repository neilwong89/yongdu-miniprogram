/* 洞察页 - 设计稿还原 WXSS */

/* === 页面框架 === */
.page {
  min-height: 100vh;
  background: #edf0e9;
  display: flex;
  flex-direction: column;
}

.page-content {
  flex: 1;
  overflow-y: auto;
  background: #fbfaf6;
  padding: 0 40rpx 160rpx;
  -webkit-overflow-scrolling: touch;
}

/* === 洞察卡片 === */
.page-header {
  padding-top: 16rpx;
}

.header-date {
  font-size: 22rpx;
  color: #88958d;
  letter-spacing: 4rpx;
  display: block;
}

.header-row2 {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 6rpx;
}

.header-title {
  font-size: 56rpx;
  font-weight: 600;
  color: #32423b;
  letter-spacing: 4rpx;
}

.header-count-pill {
  background: #e2ede3;
  color: #4f7960;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 100rpx;
}

.header-slogan {
  font-size: 26rpx;
  color: #7a887f;
  display: block;
  margin-top: 8rpx;
}

/* === 分类横滚胶囊 === */
.cats-scroll {
  margin-top: 28rpx;
  white-space: nowrap;
}

.cats-wrap {
  display: inline-flex;
  gap: 16rpx;
  padding-right: 40rpx;
}

.cat-pill {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 28rpx;
  background: #eef1e9;
  border-radius: 100rpx;
  font-size: 24rpx;
  color: #32423b;
  white-space: nowrap;
  flex-shrink: 0;
}

.cat-pill.active {
  background: #466957;
  color: #ffffff;
}

/* === 成本曲线卡片 === */
.chart-card {
  background: #e4eee5;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-top: 28rpx;
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.chart-label {
  font-size: 22rpx;
  color: #64806d;
  display: block;
}

.chart-cost {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-top: 8rpx;
}

.chart-cost-value {
  font-size: 44rpx;
  font-weight: 600;
  color: #32423b;
}

.chart-cost-unit {
  font-size: 22rpx;
  color: #64806d;
}

.chart-range-btns {
  display: flex;
  background: rgba(255,255,255,0.7);
  border-radius: 100rpx;
  padding: 6rpx;
  gap: 2rpx;
}

.range-btn {
  padding: 8rpx 18rpx;
  border-radius: 100rpx;
  font-size: 20rpx;
  color: #64806d;
}

.range-btn.active {
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.chart-svg-wrap {
  margin-top: 24rpx;
  position: relative;
}

.cost-svg {
  width: 100%;
  height: 132px;
  display: block;
}

.chart-axis-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.axis-label {
  font-size: 18rpx;
  color: #6f8475;
}

.chart-hint {
  font-size: 20rpx;
  color: #64806d;
  display: block;
  margin-top: 14rpx;
}

/* === 分类账本 === */
.section-header {
  margin-top: 40rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #32423b;
}

.section-title-group {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.section-sub {
  font-size: 22rpx;
  color: #87928a;
}

.category-table {
  background: #ffffff;
  border: 1.5rpx solid #e5e9e2;
  border-radius: 24rpx;
  overflow: hidden;
  margin-top: 20rpx;
}

.table-head {
  display: grid;
  grid-template-columns: 1.2fr 0.6fr 1fr 0.9fr;
  padding: 18rpx 28rpx;
  border-bottom: 1rpx solid #edf0eb;
}

.th {
  font-size: 20rpx;
  color: #849087;
}

.th-count,
.th-amount,
.th-cost {
  text-align: right;
}

.table-row {
  display: grid;
  grid-template-columns: 1.2fr 0.6fr 1fr 0.9fr;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid #edf0eb;
}

.table-row:last-child {
  border-bottom: none;
}

.td {
  font-size: 26rpx;
  color: #32423b;
}

.td-count,
.td-amount,
.td-cost {
  text-align: right;
}

.cost-daily {
  color: #466957;
  font-weight: 600;
}

.cost-times {
  color: #a46b3b;
}

/* === 用度之最 === */
.top-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 20rpx;
}

.top-card {
  border-radius: 24rpx;
  padding: 28rpx;
}

.top-icon {
  font-size: 36rpx;
  display: block;
}

.top-label {
  font-size: 20rpx;
  display: block;
  margin-top: 12rpx;
}

.top-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #32423b;
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top-value {
  font-size: 20rpx;
  display: block;
  margin-top: 4rpx;
}

.top-most-expensive {
  background: #f3e8da;
  color: #957252;
}

.top-most-expensive .top-value {
  color: #957252;
}

.top-longest {
  background: #e2ece5;
  color: #668070;
}

.top-longest .top-value {
  color: #668070;
}

.top-highest-daily {
  background: #ebe8f2;
  color: #7b718c;
}

.top-highest-daily .top-value {
  color: #7b718c;
}

.top-most-used {
  background: #e8f0ef;
  color: #62837e;
}

.top-most-used .top-value {
  color: #62837e;
}
