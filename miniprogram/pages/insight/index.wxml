<!-- 洞察页 -->
<view class="page">
  <!-- 导航栏 -->
  <view class="nav-bar" style="padding-top: {{navBarHeight}}px;">
    <view class="nav-title">洞察</view>
  </view>

  <!-- 空状态引导 -->
  <block wx:if="{{isEmpty}}">
    <view class="empty-state">
      <view class="empty-icon">📊</view>
      <view class="empty-title">暂无数据</view>
      <view class="empty-desc">添加第一个物品，开启你的洞察分析</view>
      <view class="empty-btn" bindtap="goAdd">去添加</view>
    </view>
  </block>

  <!-- 数据内容 -->
  <block wx:else>
    <scroll-view scroll-y class="scroll-area">

      <!-- ========== 顶部统计卡 ========== -->
      <view class="section">
        <view class="stat-cards">
          <view class="stat-card stat-card-primary">
            <view class="stat-label">总物品</view>
            <view class="stat-value">{{totalItems}}</view>
            <view class="stat-sub">使用中 {{usingItems}}</view>
          </view>
          <view class="stat-card">
            <view class="stat-label">总投入</view>
            <view class="stat-value">¥{{totalInvestment}}</view>
          </view>
          <view class="stat-card">
            <view class="stat-label">今日成本</view>
            <view class="stat-value primary">¥{{todayCost}}</view>
          </view>
          <view class="stat-card">
            <view class="stat-label">单次均摊</view>
            <view class="stat-value">¥{{avgPerUse}}</view>
          </view>
        </view>
      </view>

      <!-- ========== 成本分布 ========== -->
      <view class="section">
        <view class="section-header">
          <view class="section-title">成本分布</view>
          <view class="section-sub">按分类 · 每日成本</view>
        </view>
        <view class="category-list">
          <view
            class="category-item"
            wx:for="{{categoryStats}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="goItemDetail"
          >
            <view class="cat-left">
              <text class="cat-icon">{{item.icon}}</text>
              <view class="cat-info">
                <view class="cat-name">{{item.name}}</view>
                <view class="cat-meta">{{item.itemCount}}个物品</view>
              </view>
            </view>
            <view class="cat-right">
              <view class="cat-cost">¥{{item.dailyCostStr}}/天</view>
              <view class="cat-bar-wrap">
                <view class="cat-bar" style="width: {{item.barWidth}}%;"></view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- ========== 成本排行 ========== -->
      <view class="section">
        <view class="section-header">
          <view class="section-title">成本排行</view>
          <view class="section-sub">每日/每次成本 TOP5</view>
        </view>
        <view class="ranking-list">
          <view
            class="rank-item"
            wx:for="{{costRanking}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="goItemDetail"
          >
            <view class="rank-left">
              <view class="rank-badge" style="background: {{item.rankColor}};">
                {{item.rank}}
              </view>
              <text class="rank-icon">{{item.icon}}</text>
              <view class="rank-name">{{item.name}}</view>
            </view>
            <view class="rank-right">
              <view class="rank-cost" style="color: {{item.rankColor}};">
                ¥{{item.costStr}}
              </view>
              <view class="rank-unit">{{item.unit}}</view>
            </view>
          </view>
        </view>
      </view>

      <!-- ========== 低效率物品 ========== -->
      <view class="section" wx:if="{{lowEfficiencyItems.length > 0}}">
        <view class="section-header">
          <view class="section-title warning-title">低效率物品</view>
          <view class="section-sub">买了很久没用，性价比低</view>
        </view>
        <view class="warn-list">
          <view
            class="warn-item"
            wx:for="{{lowEfficiencyItems}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="goItemDetail"
          >
            <text class="warn-icon">{{item.icon}}</text>
            <view class="warn-info">
              <view class="warn-name">{{item.name}}</view>
              <view class="warn-reason">{{item.reason}}</view>
            </view>
            <view class="warn-arrow">›</view>
          </view>
        </view>
      </view>

      <!-- 底部留空 -->
      <view class="bottom-spacer"></view>
    </scroll-view>
  </block>
</view>
