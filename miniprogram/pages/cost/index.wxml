<!-- 用度页（首页） - 设计稿还原 -->
<view class="page">

  <!-- 字体加载中遮罩 -->
  <view wx:if="{{fontLoading}}" class="font-loading-mask">
    <view class="font-loading-inner">
      <text class="font-loading-text songti">今日用度，如约而至</text>
    </view>
  </view>

  <!-- 顶部内容区 -->
  <view class="page-content" style="padding-top: {{navBarHeight}}px;" wx:if="{{!fontLoading}}">

    <!-- 头部 -->
    <view class="page-header">
      <view class="header-left">
        <text class="header-date">YONGDU · {{todayStr}}</text>
        <text class="header-title songti">用度</text>
        <text class="header-slogan songti">把拥有，轻轻算成日常。</text>
      </view>
      <view class="header-right">
        <button class="sort-btn" bindtap="toggleSortPop">
          <text class="sort-btn-icon">☰</text>
          <text class="sort-btn-text songti">{{sortOrder === 'default' ? '排序' : '完成'}}</text>
        </button>
      </view>
    </view>

    <!-- 用度汇总卡片 -->
    <view class="summary-row">
      <!-- 左侧：今日用度 -->
      <view class="summary-card card-green">
        <text class="summary-label songti">今日用度</text>
        <view class="summary-main">
          <text class="summary-value">¥ {{todayCost}}</text>
          <text class="summary-unit songti">/ 日</text>
        </view>
      </view>
      <!-- 右侧：按次用度 -->
      <view class="summary-card card-warm">
        <text class="summary-label songti">按次用度</text>
        <view class="summary-main">
          <text class="summary-value">¥ {{remainCost}}</text>
        </view>
        <text class="summary-sub songti">每次使用均摊后递减</text>
      </view>
    </view>

    <!-- 列表标题 + 视图切换 -->
    <view class="list-header" wx:if="{{!isEmpty}}">
      <view class="list-title-group">
        <text class="list-title songti">仍在使用</text>
        <text class="list-count" wx:if="{{usingCount > 0}}">共 <text class="songti">{{usingCount}}</text> 份陪伴</text>
      </view>
      <view class="view-toggle">
        <view
          class="view-btn {{displayMode === 'card' ? 'active' : ''}}"
          bindtap="switchView"
          data-mode="card"
        >▦</view>
        <view
          class="view-btn {{displayMode === 'list' ? 'active' : ''}}"
          bindtap="switchView"
          data-mode="list"
        >☰</view>
      </view>
    </view>

    <!-- 搜索框 -->
    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input
        class="search-input songti"
        placeholder="搜索名称、购买时间或备注"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindfocus="onSearchFocus"
        bindblur="onSearchBlur"
      />
      <text wx:if="{{searchKeyword}}" class="search-clear" bindtap="onSearchClear">✕</text>
    </view>

    <!-- 分类横滚胶囊 -->
    <scroll-view class="cats-scroll" scroll-x enable-flex>
      <view class="cats-wrap">
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="cat-pill {{selectedCategory === item.id ? 'active' : ''}}"
          bindtap="selectCategory"
          data-category="{{item.id}}"
        >{{item.name}}</view>
      </view>
    </scroll-view>

    <!-- 物品列表 -->
    <view class="items-list" wx:if="{{!isEmpty}}">

      <!-- 卡片视图 -->
      <view wx:if="{{displayMode === 'card'}}" class="card-grid">
        <view
          wx:for="{{items}}"
          wx:key="id"
          class="item-card"
          bindtap="onItemTap"
          data-id="{{item.id}}"
        >
          <!-- 图片/图标区 -->
          <view class="card-media {{item.hasImage ? '' : 'media-emoji'}}">
            <image wx:if="{{item.hasImage}}" class="card-img" src="{{item.imageUrl}}" mode="aspectFill"/>
            <text wx:else class="card-emoji">{{item.icon}}</text>
            <text class="card-cat-tag">{{item.categoryName}}</text>
          </view>
          <!-- 内容区 -->
          <view class="card-body">
            <view class="card-row1">
              <text class="card-name">{{item.name}}</text>
              <text class="card-status-pill {{item.statusClass}}">{{item.statusLabel}}</text>
            </view>
            <text class="card-price">¥ {{item.priceDisplay}} · {{item.purchaseDateStr}}</text>
            <view class="card-cost-row">
              <text class="card-cost {{item.isCount ? 'cost-times' : 'cost-daily'}}">
                ¥ {{item.costDisplay}} {{item.isCount ? '/ 次' : '/ 日'}}
              </text>
              <text class="card-days" wx:if="{{!item.isCount}}"><text class="songti">相守</text> {{item.usedDays}} 天</text>
              <text class="card-days" wx:if="{{item.isCount}}"><text class="songti">动用</text> {{item.usedCount}} 次</text>
            </view>
            <!-- 按次物品的 +1 按钮 -->
            <view
              wx:if="{{item.isCount && item.status === 'using'}}"
              class="add-use-btn"
              catchtap="onUseOnce"
              data-id="{{item.id}}"
            >+</view>
          </view>
        </view>
      </view>

      <!-- 列表视图 -->
      <view wx:else class="list-view">
        <view
          wx:for="{{items}}"
          wx:key="id"
          class="list-item"
          bindtap="onItemTap"
          data-id="{{item.id}}"
        >
          <view class="list-media {{item.hasImage ? '' : 'media-emoji'}}">
            <image wx:if="{{item.hasImage}}" class="list-img" src="{{item.imageUrl}}" mode="aspectFill"/>
            <text wx:else class="list-emoji">{{item.icon}}</text>
          </view>
          <view class="list-body">
            <view class="list-row1">
              <text class="list-name">{{item.name}}</text>
              <text class="list-cost {{item.isCount ? 'cost-times' : 'cost-daily'}}">
                ¥ {{item.costDisplay}}{{item.isCount ? '/ 次' : '/ 日'}}
              </text>
            </view>
            <view class="list-row2">
              <text class="list-meta">¥ {{item.priceDisplay}} · {{item.purchaseDateStr}}</text>
              <text class="list-days" wx:if="{{!item.isCount}}">{{item.usedDays}}<text class="songti">日</text></text>
              <text class="list-days" wx:if="{{item.isCount}}">{{item.usedCount}}<text class="songti">次</text></text>
            </view>
          </view>
          <view
            wx:if="{{item.isCount && item.status === 'using'}}"
            class="list-add-btn"
            catchtap="onUseOnce"
            data-id="{{item.id}}"
          >+</view>
        </view>
      </view>

    </view>

    <!-- 空状态 -->
    <view wx:if="{{isEmpty}}" class="empty-state">
      <text class="songti empty-hint">点击下方加号记录第一个拥有</text>
    </view>

  </view>

  <!-- 排序弹层 -->
  <view wx:if="{{showSortPop}}" class="pop-overlay" bindtap="closeSortPop">
    <view class="pop-sheet" catchtap="noop">
      <view class="pop-title songti">排序方式</view>
      <view
        wx:for="{{sortOptions}}"
        wx:key="value"
        class="pop-item {{sortOrder === item.value ? 'active' : ''}}"
        bindtap="selectSort"
        data-value="{{item.value}}"
      >{{item.label}}</view>
      <view class="pop-divider"></view>
      <view class="pop-title songti">状态筛选</view>
      <view
        wx:for="{{statusOptions}}"
        wx:key="value"
        class="pop-item {{selectedStatus === item.value ? 'active' : ''}}"
        bindtap="selectStatus"
        data-status="{{item.value}}"
      >{{item.label}}</view>
      <view class="pop-cancel songti" bindtap="closeSortPop">取消</view>
    </view>
  </view>

</view>

<!-- 添加拥有弹层面板 -->
<add-cost-panel id="addCostPanel" bind:save="onAddCostSave" />
