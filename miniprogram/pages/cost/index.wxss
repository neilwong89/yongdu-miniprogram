/* 成本页 - 设计稿还原 WXSS */

/* === 字体加载遮罩 === */
.font-loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #edf0e9;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.font-loading-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.font-loading-text {
  font-size: 30rpx;
  color: #466957;
  letter-spacing: 4rpx;
}

/* === 页面框架 === */
.page {
  min-height: 100vh;
  background: #edf0e9;
  display: flex;
  flex-direction: column;
}

.page-content {
  flex: 1;
  overflow-y: auto;
  background: #fbfaf6;
  padding: 0 40rpx 200rpx;
  -webkit-overflow-scrolling: touch;
}

/* === 头部 === */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-top: 16rpx;
}

.header-date {
  font-size: 22rpx;
  color: #88958d;
  letter-spacing: 4rpx;
  display: block;
}

.header-title {
  font-size: 64rpx;
  font-weight: 600;
  color: #32423b;
  letter-spacing: 4rpx;
  display: block;
  margin-top: 4rpx;
}

.header-slogan {
  font-size: 26rpx;
  color: #7a887f;
  display: block;
  margin-top: 6rpx;
}

.sort-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #ffffff;
  border: 1.5rpx solid #dce3d9;
  border-radius: 100rpx;
  padding: 14rpx 22rpx;
  font-size: 24rpx;
  color: #32423b;
  margin-top: 8rpx;
  line-height: 1;
}

.sort-btn::after {
  border: none;
}

.sort-btn-icon {
  font-size: 22rpx;
}

/* === 分类横滚胶囊 === */
.cats-scroll {
  margin-top: 32rpx;
  white-space: nowrap;
}

.cats-wrap {
  display: inline-flex;
  gap: 16rpx;
  padding-right: 40rpx;
}

.cat-pill {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 28rpx;
  background: #eef1e9;
  border-radius: 100rpx;
  font-size: 24rpx;
  color: #32423b;
  white-space: nowrap;
  flex-shrink: 0;
}

.cat-pill.active {
  background: #466957;
  color: #ffffff;
}

/* === 搜索框 === */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #f0f2ec;
  border-radius: 24rpx;
  padding: 20rpx 28rpx;
  margin-top: 24rpx;
}

.search-icon {
  font-size: 26rpx;
  opacity: 0.5;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #32423b;
  background: transparent;
}

.search-input::placeholder {
  color: #9da79f;
}

.search-clear {
  font-size: 22rpx;
  color: #9da79f;
  flex-shrink: 0;
}

/* === 成本汇总卡片 === */
.summary-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 28rpx;
}

.summary-card {
  border-radius: 24rpx;
  padding: 28rpx;
}

.card-green {
  background: #dceadf;
}

.card-warm {
  background: #f4ead9;
}

.summary-label {
  font-size: 22rpx;
  color: #5d7968;
  display: block;
}

.card-warm .summary-label {
  color: #946f43;
}

.summary-main {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-top: 12rpx;
}

.summary-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #32423b;
  letter-spacing: -1rpx;
}

.summary-unit {
  font-size: 22rpx;
  color: #5d7968;
  font-weight: 400;
}

.summary-sub {
  font-size: 20rpx;
  color: #638070;
  display: block;
  margin-top: 10rpx;
}

.card-warm .summary-sub {
  color: #9a7850;
}

/* === 列表标题 === */
.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 40rpx;
}

.list-title-group {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.list-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #32423b;
}

.list-count {
  font-size: 22rpx;
  color: #87928a;
}

.view-toggle {
  display: flex;
  background: #eef1eb;
  border-radius: 100rpx;
  padding: 6rpx;
  gap: 2rpx;
}

.view-btn {
  width: 52rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #5d6e64;
  border-radius: 100rpx;
  background: transparent;
}

.view-btn.active {
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

/* === 物品列表 === */
.items-list {
  margin-top: 20rpx;
}

/* 卡片网格 */
.card-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.item-card {
  background: #ffffff;
  border: 1.5rpx solid #e8ebe4;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.card-media {
  position: relative;
  width: 100%;
  height: 160rpx;
  overflow: hidden;
  background: #d7e4dc;
}

.card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.media-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #dceadf;
}

.card-emoji {
  font-size: 64rpx;
}

.card-cat-tag {
  position: absolute;
  bottom: 10rpx;
  left: 10rpx;
  background: rgba(255,255,255,0.85);
  color: #32423b;
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.card-body {
  padding: 20rpx;
  position: relative;
}

.card-row1 {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 8rpx;
}

.card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #32423b;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-status-pill {
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 100rpx;
  flex-shrink: 0;
}

.card-status-pill.status-using {
  background: #e6f2e9;
  color: #4f7960;
}

.card-status-pill.status-paused {
  background: #eeeae4;
  color: #8d847a;
}

.card-status-pill.status-retired {
  background: #eeeae4;
  color: #8d847a;
}

.card-price {
  font-size: 20rpx;
  color: #7f8b83;
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-cost-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 10rpx;
}

.card-cost {
  font-size: 28rpx;
  font-weight: 600;
}

.cost-daily {
  color: #466957;
}

.cost-times {
  color: #a46b3b;
}

.card-days {
  font-size: 20rpx;
  color: #849087;
}

.add-use-btn {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  width: 48rpx;
  height: 48rpx;
  background: #f5e2cf;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #9d6333;
}

/* 列表视图 */
.list-view {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.list-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #ffffff;
  border: 1.5rpx solid #e8ebe4;
  border-radius: 24rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.list-media {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #dceadf;
  display: flex;
  align-items: center;
  justify-content: center;
}

.list-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.list-emoji {
  font-size: 48rpx;
}

.list-body {
  flex: 1;
  min-width: 0;
}

.list-row1 {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.list-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #32423b;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-cost {
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.list-row2 {
  display: flex;
  justify-content: space-between;
  margin-top: 6rpx;
}

.list-meta {
  font-size: 20rpx;
  color: #7f8b83;
}

.list-days {
  font-size: 20rpx;
  color: #849087;
  flex-shrink: 0;
}

.list-add-btn {
  width: 48rpx;
  height: 48rpx;
  background: #f5e2cf;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #9d6333;
  flex-shrink: 0;
}

/* === 空状态 === */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
}

.empty-hint {
  font-size: 30rpx;
  color: #9a9a94;
  text-align: center;
  letter-spacing: 1rpx;
}

/* === 弹层 === */
.pop-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(50, 66, 59, 0.3);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.pop-sheet {
  width: 100%;
  max-height: 70vh;
  background: #fbfaf6;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 0 60rpx;
  overflow-y: auto;
}

.pop-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #88958d;
  padding: 0 48rpx 14rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.pop-item {
  padding: 28rpx 48rpx;
  font-size: 32rpx;
  color: #32423b;
}

.pop-item.active {
  color: #466957;
  font-weight: 600;
}

.pop-divider {
  height: 1rpx;
  background: #e8ebe4;
  margin: 12rpx 0;
}

.pop-cancel {
  padding: 36rpx 48rpx;
  text-align: center;
  font-size: 32rpx;
  color: #7a887f;
  border-top: 1.5rpx solid #e8ebe4;
  margin-top: 12rpx;
}
