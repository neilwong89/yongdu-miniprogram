/* 成本页样式 - 清新淡雅风格 */

/* === 页面基础 === */
.page {
  min-height: 100vh;
  background: #f8f9fb;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* === 自定义导航栏 === */
.nav-bar {
  background: #ffffff;
  padding: 0 32rpx 24rpx;
}

.nav-content {
  padding-top: 8rpx;
}

.nav-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a2e;
  letter-spacing: 2rpx;
}

.nav-slogan {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

/* === 搜索栏 === */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  background: #ffffff;
  gap: 16rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f6f8;
  border-radius: 24rpx;
  padding: 16rpx 24rpx;
  gap: 12rpx;
}

.icon-search {
  font-size: 28rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-input::placeholder {
  color: #bbb;
}

.icon-clear {
  font-size: 28rpx;
  color: #ccc;
  padding: 4rpx;
}

.search-cancel {
  font-size: 28rpx;
  color: #666;
  white-space: nowrap;
}

/* === 工具栏 === */
.tool-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
}

.filter-tags {
  display: flex;
  gap: 16rpx;
}

.filter-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: #666;
  padding: 8rpx 16rpx;
  background: #f5f6f8;
  border-radius: 16rpx;
}

.filter-tag.active {
  background: #e8f4ff;
  color: #3a7fff;
}

.arrow {
  font-size: 18rpx;
  opacity: 0.6;
}

.tool-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.sort-btn {
  font-size: 26rpx;
  color: #666;
}

.view-toggle {
  display: flex;
  gap: 12rpx;
}

.view-icon {
  font-size: 32rpx;
  color: #ccc;
}

.view-icon.active {
  color: #333;
}

/* === 成本汇总区 === */
.summary-section {
  padding: 24rpx 32rpx;
}

.summary-card {
  background: linear-gradient(135deg, #ffffff 0%, #f8f9fb 100%);
  border-radius: 24rpx;
  padding: 32rpx 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
}

.summary-item {
  flex: 1;
}

.summary-label {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.summary-value {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
}

.summary-value.primary {
  color: #1a1a2e;
  font-size: 48rpx;
}

.summary-sub {
  font-size: 22rpx;
  color: #999;
  font-weight: 400;
  margin-left: 8rpx;
}

.summary-divider {
  width: 1rpx;
  height: 64rpx;
  background: #eee;
  margin: 0 40rpx;
}

/* === 物品列表 === */
.items-section {
  padding: 0 32rpx 32rpx;
}

/* 卡片视图 */
.card-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.item-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  position: relative;
  overflow: hidden;
}

.item-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #e8f4ff, #dceaff);
  border-radius: 20rpx 20rpx 0 0;
}

.card-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.card-body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.card-sep {
  opacity: 0.5;
}

.card-status {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.card-status.status-using {
  background: #e8f4ff;
  color: #3a7fff;
}

.card-status.status-other {
  background: #f5f5f5;
  color: #999;
}

.card-cost {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-top: 8rpx;
}

.cost-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.cost-unit {
  font-size: 22rpx;
  color: #999;
}

.use-btn {
  width: 36rpx;
  height: 36rpx;
  background: linear-gradient(135deg, #3a7fff, #5a9fff);
  color: #fff;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  margin-left: auto;
  box-shadow: 0 4rpx 12rpx rgba(58, 127, 255, 0.3);
}

.card-used {
  font-size: 22rpx;
  color: #bbb;
}

/* 列表视图 */
.list-view {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
  gap: 20rpx;
}

.list-item:last-child {
  border-bottom: none;
}

.list-icon {
  font-size: 40rpx;
}

.list-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.list-category {
  font-size: 24rpx;
  color: #999;
  width: 120rpx;
  text-align: center;
}

.list-cost {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  width: 140rpx;
  text-align: right;
}

.list-used {
  font-size: 22rpx;
  color: #bbb;
  width: 100rpx;
  text-align: right;
}

/* === 空状态 === */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  gap: 24rpx;
}

.empty-illustration {
  font-size: 120rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.empty-desc {
  font-size: 28rpx;
  color: #999;
}

.empty-btn {
  margin-top: 16rpx;
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #3a7fff, #5a9fff);
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(58, 127, 255, 0.3);
}

/* === 弹层 === */
.pop-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.pop-sheet {
  width: 100%;
  max-height: 70vh;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 0;
  overflow-y: auto;
}

.pop-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #999;
  padding: 0 40rpx 16rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.pop-item {
  padding: 28rpx 40rpx;
  font-size: 32rpx;
  color: #333;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pop-item.active {
  color: #3a7fff;
  font-weight: 600;
}

.pop-divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 16rpx 0;
}

.pop-cancel {
  padding: 32rpx 40rpx;
  text-align: center;
  font-size: 32rpx;
  color: #999;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 16rpx;
}
