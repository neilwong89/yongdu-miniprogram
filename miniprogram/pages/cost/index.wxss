/* 成本页样式 - 清新淡雅风格 */

/* === 全局基础 === */
page {
  background: #f5f3ef;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

/* === 页面框架 === */
.page {
  min-height: 100vh;
  background: #f5f3ef;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* === 导航栏 === */
.nav-bar {
  background: #f5f3ef;
  padding: 0 40rpx 20rpx;
}

.nav-content {
  padding-top: 8rpx;
}

.nav-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #2d3436;
  letter-spacing: -1rpx;
}

.nav-slogan {
  font-size: 24rpx;
  color: #9e9a93;
  margin-top: 4rpx;
  letter-spacing: 0.5rpx;
}

/* === 搜索栏 === */
.search-bar {
  display: flex;
  align-items: center;
  padding: 0 40rpx 20rpx;
  background: #f5f3ef;
  gap: 16rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1.5rpx solid #e4e0d8;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  gap: 12rpx;
  transition: border-color 0.2s;
}

.search-input-wrap:focus-within {
  border-color: #a8c5a8;
}

.icon-search {
  font-size: 26rpx;
  opacity: 0.4;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #2d3436;
  background: transparent;
}

.search-input::placeholder {
  color: #c5c0b6;
}

.icon-clear {
  font-size: 24rpx;
  color: #c5c0b6;
  padding: 4rpx;
}

.search-cancel {
  font-size: 28rpx;
  color: #9e9a93;
  white-space: nowrap;
}

/* === 工具栏 === */
.tool-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 40rpx;
  background: #f5f3ef;
}

.filter-tags {
  display: flex;
  gap: 12rpx;
}

.filter-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 25rpx;
  color: #7a756c;
  padding: 10rpx 18rpx;
  background: #ffffff;
  border: 1.5rpx solid #e4e0d8;
  border-radius: 100rpx;
  transition: all 0.2s;
}

.filter-tag.active {
  background: #e8f2e8;
  border-color: #a8c5a8;
  color: #5a7a5a;
}

.arrow {
  font-size: 18rpx;
  opacity: 0.5;
}

.tool-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.sort-btn {
  font-size: 25rpx;
  color: #7a756c;
  background: #ffffff;
  border: 1.5rpx solid #e4e0d8;
  border-radius: 100rpx;
  padding: 10rpx 18rpx;
}

.view-toggle {
  display: flex;
  gap: 8rpx;
}

.view-icon {
  font-size: 30rpx;
  color: #c5c0b6;
  padding: 8rpx;
  background: #ffffff;
  border: 1.5rpx solid #e4e0d8;
  border-radius: 10rpx;
}

.view-icon.active {
  color: #5a7a5a;
  background: #e8f2e8;
  border-color: #a8c5a8;
}

/* === 成本汇总区 === */
.summary-section {
  padding: 8rpx 40rpx 24rpx;
}

.summary-card {
  background: #ffffff;
  border: 1.5rpx solid #e4e0d8;
  border-radius: 24rpx;
  padding: 36rpx 44rpx;
  display: flex;
  align-items: center;
}

.summary-item {
  flex: 1;
}

.summary-label {
  font-size: 24rpx;
  color: #9e9a93;
  margin-bottom: 8rpx;
  letter-spacing: 0.5rpx;
}

.summary-value {
  font-size: 42rpx;
  font-weight: 700;
  color: #2d3436;
  letter-spacing: -1rpx;
}

.summary-value.primary {
  color: #3d5a3d;
  font-size: 52rpx;
}

.summary-sub {
  font-size: 22rpx;
  color: #9e9a93;
  font-weight: 400;
  margin-left: 8rpx;
}

.summary-divider {
  width: 1rpx;
  height: 64rpx;
  background: #e4e0d8;
  margin: 0 40rpx;
}

/* === 物品列表 === */
.items-section {
  padding: 0 40rpx 40rpx;
}

/* 卡片视图 */
.card-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.item-card {
  background: #ffffff;
  border: 1.5rpx solid #e4e0d8;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  position: relative;
  transition: box-shadow 0.2s, border-color 0.2s;
}

.item-card:active {
  border-color: #c5c0b6;
}

.card-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
  line-height: 1;
}

.card-body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d3436;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #9e9a93;
}

.card-sep {
  opacity: 0.5;
}

.card-status {
  font-size: 20rpx;
  padding: 3rpx 10rpx;
  border-radius: 100rpx;
  background: #f0ede8;
  color: #9e9a93;
}

.card-status.status-using {
  background: #e8f2e8;
  color: #5a7a5a;
}

.card-cost {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-top: 10rpx;
}

.cost-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #3d5a3d;
}

.cost-unit {
  font-size: 22rpx;
  color: #9e9a93;
}

.use-btn {
  width: 38rpx;
  height: 38rpx;
  background: #5a7a5a;
  color: #fff;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  margin-left: auto;
}

.card-used {
  font-size: 22rpx;
  color: #bbb7ad;
}

/* 列表视图 */
.list-view {
  background: #ffffff;
  border: 1.5rpx solid #e4e0d8;
  border-radius: 20rpx;
  overflow: hidden;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid #f0ede8;
  gap: 20rpx;
}

.list-item:last-child {
  border-bottom: none;
}

.list-icon {
  font-size: 40rpx;
}

.list-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #2d3436;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.list-category {
  font-size: 24rpx;
  color: #9e9a93;
  width: 120rpx;
  text-align: center;
}

.list-cost {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d5a3d;
  width: 140rpx;
  text-align: right;
}

.list-used {
  font-size: 22rpx;
  color: #bbb7ad;
  width: 100rpx;
  text-align: right;
}

/* === 空状态 === */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  gap: 20rpx;
}

.empty-illustration {
  font-size: 100rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #4a4540;
}

.empty-desc {
  font-size: 28rpx;
  color: #9e9a93;
}

.empty-btn {
  margin-top: 12rpx;
  padding: 22rpx 64rpx;
  background: #5a7a5a;
  color: #fff;
  border-radius: 100rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* === 弹层 === */
.pop-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(45, 52, 54, 0.25);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.pop-sheet {
  width: 100%;
  max-height: 70vh;
  background: #faf8f4;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 0 60rpx;
  overflow-y: auto;
}

.pop-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #9e9a93;
  padding: 0 48rpx 14rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.pop-item {
  padding: 28rpx 48rpx;
  font-size: 32rpx;
  color: #4a4540;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pop-item.active {
  color: #5a7a5a;
  font-weight: 600;
}

.pop-divider {
  height: 1rpx;
  background: #e4e0d8;
  margin: 12rpx 0;
}

.pop-cancel {
  padding: 36rpx 48rpx;
  text-align: center;
  font-size: 32rpx;
  color: #9e9a93;
  border-top: 1rpx solid #e4e0d8;
  margin-top: 12rpx;
}
