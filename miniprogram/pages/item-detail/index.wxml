<view class="page" wx:if="{{item}}">

  <!-- 头部：图标 + 名称 + 标签 -->
  <view class="header">
    <view class="icon-wrap">
      <text class="icon">{{item.icon}}</text>
    </view>
    <view class="title-row">
      <text class="name">{{item.name}}</text>
      <view class="tags">
        <text class="tag category">{{item.categoryName}}</text>
        <text class="tag status" style="background:{{statusInfo.color}}">{{statusInfo.label}}</text>
      </view>
    </view>
  </view>

  <!-- 成本卡片 -->
  <view class="cost-card">
    <view class="cost-main">
      <text class="cost-label">单次/日均成本</text>
      <text class="cost-value">¥{{costPerUnit}}</text>
      <text class="cost-unit">元/{{unitLabel}}</text>
    </view>
    <view class="cost-divider"></view>
    <view class="cost-sub">
      <view class="cost-item">
        <text class="ci-label">总花费</text>
        <text class="ci-value">¥{{totalAmount}}</text>
      </view>
      <view class="cost-item">
        <text class="ci-label">已用</text>
        <text class="ci-value">{{item.unit === 'day' ? usedDays + '天' : usedCount + '次'}}</text>
      </view>
    </view>
  </view>

  <!-- 明细列表 -->
  <view class="detail-list">

    <view class="detail-item">
      <text class="di-key">购买日期</text>
      <text class="di-val">{{purchaseDateStr}}</text>
    </view>

    <view class="detail-item">
      <text class="di-key">购买单价</text>
      <text class="di-val">¥{{itemPriceDisplay}}</text>
    </view>

    <view class="detail-item" wx:if="{{item.otherFees > 0}}">
      <text class="di-key">其他费用</text>
      <text class="di-val">¥{{otherFeesDisplay}}</text>
    </view>

    <view class="detail-item">
      <text class="di-key">计量方式</text>
      <text class="di-val">{{item.unit === 'day' ? '按天摊分' : '按次计费'}}</text>
    </view>

    <view class="detail-item" wx:if="{{item.remark}}">
      <text class="di-key">备注</text>
      <text class="di-val remark">{{item.remark}}</text>
    </view>

    <!-- 卖出信息（已报废） -->
    <view class="detail-item sold" wx:if="{{item.status === 'retired' && soldDateStr}}">
      <text class="di-key">卖出信息</text>
      <text class="di-val">{{soldDateStr}}</text>
    </view>

  </view>

  <!-- 底部操作 -->
  <view class="bottom-bar">
    <!-- 按次物品的 +1 按钮 -->
    <button
      wx:if="{{item.unit === 'count'}}"
      class="btn-use"
      bindtap="onUseOnce"
    >+1 次</button>

    <button class="btn-edit" bindtap="onEdit">编辑</button>
    <button class="btn-delete" bindtap="onDelete">删除</button>
  </view>

</view>
