<!-- 用度详情页 - 设计稿还原 -->
<view class="page" wx:if="{{item}}">

  <!-- 主内容（可滚动） -->
  <scroll-view class="detail-scroll" scroll-y>
    <view class="detail-content">

      <!-- 顶部导航 -->
      <view class="detail-header">
        <view class="back-btn" bindtap="goBack">
          <text class="back-icon">←</text>
        </view>
        <text class="header-title-text songti">这份拥有</text>
        <view class="edit-btn" bindtap="onEdit">
          <text>编辑</text>
        </view>
      </view>

      <!-- 图片/图表区域 -->
      <view class="media-card">
        <view class="media-inner" wx:if="{{item.imageUrl}}">
          <image class="card-img" src="{{item.imageUrl}}" mode="aspectFill"/>
          <view class="media-overlay"></view>
        </view>
        <view class="media-placeholder" wx:else>
          <text class="placeholder-emoji">{{item.icon}}</text>
        </view>
        <view class="media-bottom">
          <view class="media-tags">
            <text class="media-cat-tag">{{item.categoryName}}</text>
          </view>
        </view>
      </view>

      <!-- 拥有标题卡片 -->
      <view class="title-card">
        <view class="title-row">
          <text class="item-name">{{item.name}}</text>
          <text class="status-pill {{item.statusClass}}">{{item.statusLabel}}</text>
        </view>
        <text class="item-remark" wx:if="{{item.remark}}">{{item.remark}}</text>
      </view>

      <!-- 用度展示卡片 -->
      <view class="cost-display-card">
        <text class="cost-display-label songti">当前日均</text>
        <view class="cost-display-main">
          <text class="cost-display-value">¥ {{costPerUnit}}</text>
          <text class="cost-display-unit">/ {{unitLabel}}</text>
        </view>
        <!-- 进度条 -->
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{progressPercent}}%;"></view>
        </view>
        <view class="progress-labels">
          <text class="progress-label"><text class="songti">{{usedDays}}</text> 日相守</text>
          <text class="progress-label" wx:if="{{item.expectedDays}}">预计 <text class="songti">{{item.expectedDays}}</text> 日</text>
        </view>
      </view>

      <!-- 明细列表 -->
      <view class="detail-list">
        <view class="detail-item">
          <text class="di-key">入手价</text>
          <text class="di-val">¥ {{itemPriceDisplay}}</text>
        </view>
        <view class="detail-item">
          <text class="di-key">入手日期</text>
          <text class="di-val">{{purchaseDateStr}}</text>
        </view>
        <view class="detail-item" wx:if="{{item.otherFees > 0}}">
          <text class="di-key">其他投入</text>
          <text class="di-val">¥ {{otherFeesDisplay}}</text>
        </view>
        <view class="detail-item">
          <text class="di-key">分摊方式</text>
          <text class="di-val">{{item.unit === 'day' ? '按日均摊' : '按次计费'}}</text>
        </view>
        <view class="detail-item" wx:if="{{item.expectedDays}}">
          <text class="di-key">预期相伴</text>
          <text class="di-val"><text class="songti">{{item.expectedDays}}</text> 日</text>
        </view>
        <view class="detail-item" wx:if="{{item.remark}}">
          <text class="di-key">备注</text>
          <text class="di-val di-val-remark">{{item.remark}}</text>
        </view>
        <!-- 卖出信息 -->
        <view class="detail-item" wx:if="{{item.status === 'retired' && soldDateStr}}">
          <text class="di-key">出手记录</text>
          <text class="di-val">{{soldDateStr}}</text>
        </view>
      </view>

    </view>
  </scroll-view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bar-edit-btn" bindtap="onEdit">修改</view>
    <view class="bar-delete-btn" bindtap="onDelete">删除</view>
  </view>

</view>

<!-- 编辑拥有弹层面板 -->
<add-cost-panel id="addCostPanel" bind:save="onEditSave" />
