/* item-detail 页面样式 */
.page {
  padding: 24rpx;
  padding-bottom: 140rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 头部 */
.header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.icon-wrap {
  width: 100rpx;
  height: 100rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon {
  font-size: 56rpx;
}

.title-row {
  flex: 1;
}

.name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  color: #fff;
}

.tag.category {
  background: #1aad19;
}

.tag.status {
  opacity: 0.9;
}

/* 成本卡片 */
.cost-card {
  background: linear-gradient(135deg, #1aad19, #0d8a00);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  color: #fff;
}

.cost-main {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.cost-label {
  font-size: 26rpx;
  opacity: 0.85;
}

.cost-value {
  font-size: 56rpx;
  font-weight: bold;
}

.cost-unit {
  font-size: 26rpx;
  opacity: 0.85;
}

.cost-divider {
  height: 1rpx;
  background: rgba(255,255,255,0.2);
  margin-bottom: 24rpx;
}

.cost-sub {
  display: flex;
  gap: 40rpx;
}

.cost-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ci-label {
  font-size: 24rpx;
  opacity: 0.75;
}

.ci-value {
  font-size: 32rpx;
  font-weight: bold;
}

/* 明细列表 */
.detail-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-item:last-child {
  border-bottom: none;
}

.di-key {
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.di-val {
  font-size: 28rpx;
  color: #333;
  text-align: right;
  max-width: 380rpx;
  word-break: break-all;
}

.di-val.remark {
  color: #666;
  font-size: 26rpx;
  line-height: 1.5;
}

.detail-item.sold .di-val {
  color: #ff6b00;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.06);
}

.btn-use {
  flex: 1;
  background: #ff9800;
  color: #fff;
  font-size: 30rpx;
  border-radius: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.btn-edit {
  flex: 1;
  background: #1aad19;
  color: #fff;
  font-size: 30rpx;
  border-radius: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.btn-delete {
  flex: 1;
  background: #f5f5f5;
  color: #e64340;
  font-size: 30rpx;
  border-radius: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
}
