/* item-detail 页面样式 - 清新淡雅 */
page {
  background: #f5f3ef;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.page {
  padding: 32rpx 40rpx 140rpx;
  background: #f5f3ef;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 头部 */
.header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
  background: #ffffff;
  border: 1.5rpx solid #e4e0d8;
  border-radius: 24rpx;
  padding: 32rpx;
}

.icon-wrap {
  width: 100rpx;
  height: 100rpx;
  background: #f5f3ef;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1.5rpx solid #e4e0d8;
}

.icon {
  font-size: 56rpx;
}

.title-row {
  flex: 1;
}

.name {
  font-size: 40rpx;
  font-weight: 700;
  color: #2d3436;
  display: block;
  margin-bottom: 14rpx;
  letter-spacing: -0.5rpx;
}

.tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  padding: 5rpx 14rpx;
  border-radius: 100rpx;
  color: #fff;
}

.tag.category {
  background: #6b7c5e;
}

.tag.status {
  opacity: 0.85;
}

/* 成本卡片 */
.cost-card {
  background: #6b7c5e;
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 32rpx;
  color: #fff;
}

.cost-main {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 28rpx;
}

.cost-label {
  font-size: 26rpx;
  opacity: 0.8;
}

.cost-value {
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
}

.cost-unit {
  font-size: 26rpx;
  opacity: 0.8;
}

.cost-divider {
  height: 1rpx;
  background: rgba(255,255,255,0.15);
  margin-bottom: 28rpx;
}

.cost-sub {
  display: flex;
  gap: 48rpx;
}

.cost-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ci-label {
  font-size: 24rpx;
  opacity: 0.7;
}

.ci-value {
  font-size: 34rpx;
  font-weight: 600;
}

/* 明细列表 */
.detail-list {
  background: #ffffff;
  border: 1.5rpx solid #e4e0d8;
  border-radius: 24rpx;
  overflow: hidden;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0ede8;
}

.detail-item:last-child {
  border-bottom: none;
}

.di-key {
  font-size: 28rpx;
  color: #9e9a93;
  flex-shrink: 0;
}

.di-val {
  font-size: 28rpx;
  color: #2d3436;
  text-align: right;
  max-width: 380rpx;
  word-break: break-all;
}

.di-val.remark {
  color: #7a756c;
  font-size: 26rpx;
  line-height: 1.6;
}

.detail-item.sold .di-val {
  color: #b05a3a;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #f5f3ef;
  border-top: 1.5rpx solid #e4e0d8;
}

.btn-use {
  flex: 1;
  background: #b05a3a;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 100rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.btn-edit {
  flex: 1;
  background: #6b7c5e;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 100rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.btn-delete {
  flex: 1;
  background: #ffffff;
  border: 1.5rpx solid #e4e0d8;
  color: #9e9a93;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 100rpx;
  height: 88rpx;
  line-height: 88rpx;
}
