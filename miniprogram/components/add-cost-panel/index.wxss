/* === 字体（对应 app.wxss 的 songti class）=== */
.songti {
  font-family: 'SimSun', Georgia, serif;
}

/* === 遮罩 === */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(50, 66, 59, 0.35);
  z-index: 998;
  opacity: 0;
}

/* === 面板 === */
.panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100vh;
  background: #fbfaf6;
  border-radius: 0;
  z-index: 999;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
}

/* 拖动指示条（吸顶） */
.drag-indicator-wrap {
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.drag-indicator {
  width: 80rpx;
  height: 8rpx;
  background: #d4d8d1;
  border-radius: 100rpx;
}

/* === 可滚动主体 === */
.panel-body {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 120rpx; /* 底部留白，避免 FAB 按钮挡住内容 */
}

.form-content {
  padding: 0 40rpx 40rpx;
}

/* === 顶部标题栏 === */
.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 0 32rpx;
}

.close-btn {
  font-size: 30rpx;
  color: #7a887f;
  padding: 8rpx 0;
}

.save-btn {
  font-size: 30rpx;
  color: #466957;
  font-weight: 600;
  padding: 8rpx 0;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #32423b;
}

/* === 图片上传区 === */
.photo-upload {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #f0f5ef;
  border: 3rpx dashed #b8c9ba;
  border-radius: 24rpx;
  padding: 32rpx;
}

.upload-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  background: #dceadf;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.upload-icon {
  font-size: 48rpx;
}

.upload-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.upload-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #32423b;
}

.upload-sub {
  font-size: 24rpx;
  color: #7b897f;
}

/* === 图片预览 === */
.photo-preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  object-fit: cover;
  flex-shrink: 0;
}

.photo-replace-hint {
  font-size: 22rpx;
  color: #7b897f;
  margin-left: 16rpx;
}

/* === 隐藏 canvas === */
.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 300px;
  height: 300px;
}

/* === 表单区 === */
.form-sections {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
}

.field-row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0ede8;
}

.field-row.cols-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.field-group {
  display: flex;
  flex-direction: column;
}

.field-label {
  font-size: 24rpx;
  color: #8b968f;
  margin-bottom: 14rpx;
  letter-spacing: 1rpx;
}

.field-input {
  background: #f0f2ec;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  font-size: 30rpx;
  color: #32423b;
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  margin-top: 14rpx;
  line-height: 1.4;
}

.field-input::placeholder {
  color: #9da79f;
}

.field-textarea {
  background: #f0f2ec;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  color: #32423b;
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
  margin-top: 14rpx;
  line-height: 1.5;
}

.field-textarea::placeholder {
  color: #9da79f;
}

.field-select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f0f2ec;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  margin-top: 14rpx;
}

.field-select-val {
  font-size: 30rpx;
  color: #32423b;
}

.field-arrow {
  font-size: 32rpx;
  color: #9da79f;
}

/* === Emoji 选择器 === */
.emoji-row {
  margin-bottom: 12rpx;
}

.emoji-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.emoji-item {
  font-size: 40rpx;
  padding: 6rpx;
  border-radius: 8rpx;
  transition: background 0.15s;
}

.emoji-item.active {
  background: #dceadf;
}

/* === 分摊方式卡片 === */
.method-card {
  background: #e6eee7;
  border-radius: 24rpx;
  padding: 28rpx;
  margin: 24rpx 0;
}

.method-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #32423b;
}

.method-btns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 18rpx;
}

.method-btn {
  padding: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #32423b;
  text-align: center;
  transition: all 0.2s;
}

.method-btn.active {
  background: #466957;
  color: #ffffff;
}

.method-hint {
  font-size: 22rpx;
  color: #668070;
  display: block;
  margin-top: 16rpx;
  line-height: 1.6;
}

/* === 选择器弹层 === */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(50, 66, 59, 0.3);
  z-index: 1001;
  display: flex;
  align-items: flex-end;
}

.picker-sheet {
  width: 100%;
  background: #fbfaf6;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 0 60rpx;
}

.picker-item {
  text-align: center;
  line-height: 80rpx;
  font-size: 30rpx;
  color: #32423b;
}

.picker-cancel {
  text-align: center;
  color: #7a887f;
  font-size: 30rpx;
  padding: 24rpx;
}

/* === 自定义分类弹窗 === */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(50, 66, 59, 0.3);
  z-index: 1001;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog {
  width: 560rpx;
  background: #fbfaf6;
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 36rpx;
  color: #32423b;
}

.dialog-input {
  background: #f0f2ec;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  font-size: 30rpx;
  color: #32423b;
  margin-bottom: 36rpx;
  width: 100%;
  box-sizing: border-box;
}

.dialog-input::placeholder {
  color: #9da79f;
}

.dialog-btns {
  display: flex;
  gap: 20rpx;
}

.dialog-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 100rpx;
  font-size: 30rpx;
}

.dialog-btn.cancel {
  background: #ffffff;
  border: 1.5rpx solid #e8ebe4;
  color: #7a887f;
}

.dialog-btn.confirm {
  background: #466957;
  color: #ffffff;
}

/* 两个操作按钮 */
.action-area {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 56rpx;
  padding: 32rpx 0 16rpx;
}

.action-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 默认隐藏 */
  transform: scale(0);
  opacity: 0;
  transition: transform 0.22s ease-out, opacity 0.18s ease;
}

.action-icon {
  font-size: 36rpx;
  font-weight: bold;
  line-height: 1;
}

/* 取消按钮：红色 */
.cancel-btn {
  background: #e54d42;
}

.cancel-btn .action-icon {
  color: #ffffff;
}

/* 保存按钮：绿色 */
.save-btn {
  background: #466957;
}

.save-btn .action-icon {
  color: #ffffff;
}

/* 弹层打开时：✓ 和 ✕ 展开 */
.panel-open .cancel-btn,
.panel-open .save-btn {
  transform: scale(1);
  opacity: 1;
  transition: transform 0.22s ease-out, opacity 0.18s ease;
}
