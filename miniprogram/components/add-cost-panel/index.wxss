/* === 字体（对应 app.wxss 的 songti class）=== */
.songti {
  font-family: 'SimSun', Georgia, serif;
}

/* === 全局统一变量约定（固化到整个小程序）===
   - 圆角: 20rpx
   - 内边距: 28rpx
   - 外边距: 24rpx
   - 主色: #466957 森林绿
   - 背景: #fbfaf6 米白
   - 输入框背景: #f0f2ec 象灰
   - 按钮背景: #e6eee7 象白
   - 文字色: #32423b 深森绿
   - 次要文字: #8b968f 灰绿
   - 分隔线: 全部去掉（简约风格）
*/

/* === 遮罩 === */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(50, 66, 59, 0.35);
  z-index: 998;
  opacity: 0;
}

/* === 面板 === */
.panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100vh;
  background: #fbfaf6;
  border-radius: 0;
  z-index: 999;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
}

/* 拖动指示条（吸顶） */
.drag-indicator-wrap {
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.drag-indicator {
  width: 80rpx;
  height: 8rpx;
  background: #d4d8d1;
  border-radius: 100rpx;
}

/* === 可滚动主体 === */
.panel-body {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 120rpx; /* 底部留白，避免 FAB 按钮挡住内容 */
}

.form-content {
  padding: 0 40rpx 40rpx;
}

/* === 顶部标题栏 === */
.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 0 32rpx;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #32423b;
}

/* === 图片上传区（三态） === */

/* 状态三：默认——整体一块按钮，中间斜杠分隔 */
.photo-upload {
  position: relative;
  display: flex;
  height: 88rpx;
  margin: 24rpx 0;
}

/* 统一按钮样式：整体一块，各占一半 */
.photo-btn,
.icon-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e6eee7;
  box-sizing: border-box;
}

.photo-btn {
  border-radius: 20rpx 0 0 20rpx;
  padding-left: 36rpx;
}

.icon-btn {
  border-radius: 0 20rpx 20rpx 0;
  padding-right: 36rpx;
}

/* 斜向分割线 + 或字容器 */
.photo-upload::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 6rpx;
  height: 200%;
  background: #fbfaf6;
  transform: translate(-50%, -50%) rotate(20deg);
  border-radius: 100rpx;
  z-index: 1;
}

/* 或字圆形背景 */
.or-badge {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 48rpx;
  height: 48rpx;
  background: #fbfaf6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.or-text {
  font-size: 28rpx;
  color: #8b968f;
  font-family: 'SimSun', Georgia, serif;
  letter-spacing: 0;
  line-height: 1;
}

.photo-btn-text,
.icon-btn-text {
  font-size: 26rpx;
  color: #32423b;
  font-family: 'SimSun', Georgia, serif;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 2;
}

/* 状态一：已选图片 → 全幅展示 */
.photo-full-wrap {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  background: #e6eee7;
}

.photo-full {
  width: 100%;
  height: 280rpx;
  display: block;
}

.photo-full-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.35));
}

.photo-full-tip {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
}

/* 状态二：已选图标 → 大图标居中展示 */
.icon-full-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #e6eee7;
  border-radius: 24rpx;
  padding: 56rpx 24rpx 48rpx;
  min-height: 280rpx;
  box-sizing: border-box;
}

.icon-full-emoji {
  font-size: 96rpx;
  line-height: 1;
}

.icon-full-tip {
  font-size: 26rpx;
  color: #7b897f;
  margin-top: 16rpx;
}

/* 清除按钮 */
.clear-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0,0,0,0.45);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #ffffff;
  z-index: 2;
}

/* 默认占位图 */
.photo-placeholder {
  width: 100%;
  height: 280rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #e6eee7;
  border-radius: 24rpx;
  gap: 16rpx;
}

.photo-placeholder-icon {
  font-size: 80rpx;
  line-height: 1;
}

.photo-placeholder-tip {
  font-size: 28rpx;
  color: #9da79f;
  letter-spacing: 2rpx;
}

/* .photo-btn.has-photo 已移除（不再使用） */

/* === 隐藏 canvas === */
.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 300px;
  height: 300px;
}

/* === 表单区 === */
.form-sections {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
}

.field-row {
  padding: 24rpx 0;
  /* 分隔线：全部去掉，简约风格 */
  border-bottom: none;
}

.field-row.cols-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.field-group {
  display: flex;
  flex-direction: column;
}

.field-label {
  font-size: 24rpx;
  color: #8b968f;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.field-input {
  background: #f0f2ec;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  color: #32423b;
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  line-height: 1.4;
}

.field-input::placeholder {
  color: #9da79f;
}

.field-textarea {
  background: #f0f2ec;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: #32423b;
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
  line-height: 1.5;
}

.field-textarea::placeholder {
  color: #9da79f;
}

.field-select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f0f2ec;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
}

.field-select-val {
  font-size: 30rpx;
  color: #32423b;
}

.field-arrow {
  font-size: 32rpx;
  color: #9da79f;
}

/* === 类别选择器 === */
.category-section {
  margin: 24rpx 0;
}

/* 外层容器（相对定位，内部absolute相对于它） */
.category-overlayer {
  position: relative;
  margin-top: 12rpx;
  min-height: 72rpx;
}

/* 滚动条浮层（absolute浮在上方，不占文档流位） */
.category-row-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 2;
  background: #fbfaf6;
  transition: opacity 0.22s ease-out;
  height: 72rpx;
}

.category-row-overlay.hidden {
  opacity: 0;
  pointer-events: none;
}

/* 横向滚动区 */
.category-scroll {
  white-space: nowrap;
  padding-right: 70rpx;
  box-sizing: border-box;
  height: 72rpx;
  display: block;
}

.category-tag {
  display: inline-block;
  padding: 14rpx 28rpx;
  background: #f0f2ec;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #32423b;
  margin-right: 12rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  height: 54rpx;
  line-height: 1;
  vertical-align: top;
}

.category-tag.active {
  background: #466957;
  color: #ffffff;
}

/* 自定义类别按钮（横向标签虚线样式） */
.category-tag.custom-btn {
  background: transparent;
  border: 2rpx dashed #b0b8b3;
  color: #8b968f;
}

.category-tag.custom-btn.active {
  background: #466957;
  border-color: #466957;
  color: #ffffff;
}

/* 圆形展开按钮（固定在右侧，绝对定位，与标签顶部对齐） */
.category-expand-btn {
  position: absolute;
  right: 0;
  top: 0;
  width: 54rpx;
  height: 54rpx;
  background: #e6eee7;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
}

.category-expand-arrow {
  font-size: 32rpx;
  color: #466957;
  line-height: 1;
  transition: transform 0.22s ease-out;
}

.category-expand-arrow.rotated {
  transform: rotate(90deg);
}

/* 展开的纵向网格（文档流内，撑开页面） */
.category-expand-wrap {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.28s ease-out;
}

.category-expand-wrap.expanded {
  max-height: 600rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: flex-start;
}

.category-chip {
  display: inline-block;
  padding: 14rpx 28rpx;
  background: #f0f2ec;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #32423b;
  flex-shrink: 0;
  box-sizing: border-box;
  height: 54rpx;
  line-height: 1;
}

.category-chip.active {
  background: #466957;
  color: #ffffff;
}

/* 自定义类别按钮（网格内虚线样式） */
.category-chip.custom-btn {
  background: transparent;
  border: 2rpx dashed #b0b8b3;
  color: #8b968f;
}

.category-chip.custom-btn.active {
  background: #466957;
  border-color: #466957;
  color: #ffffff;
}

/* 圆形展开按钮（固定在右侧，不遮挡） */
.category-expand-btn {
  position: absolute;
  right: 0;
  top: 50%;
  margin-top: -32rpx;
  width: 64rpx;
  height: 64rpx;
  background: #e6eee7;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  z-index: 2;
}

.category-expand-arrow {
  font-size: 32rpx;
  color: #466957;
  transition: transform 0.25s ease-out;
  display: inline-block;
  line-height: 1;
}

.category-expand-btn.expanded .category-expand-arrow {
  transform: rotate(90deg);
}

/* === 分摊方式卡片 === */
.method-card {
  background: #e6eee7;
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 24rpx 0;
}

.method-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #32423b;
}

.method-btns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 18rpx;
}

.method-btn {
  padding: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #32423b;
  text-align: center;
  transition: all 0.2s;
}

.method-btn.active {
  background: #466957;
  color: #ffffff;
}

.method-hint {
  font-size: 22rpx;
  color: #668070;
  display: block;
  margin-top: 16rpx;
  line-height: 1.6;
}

/* === 选择器弹层 === */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(50, 66, 59, 0.3);
  z-index: 1001;
  display: flex;
  align-items: flex-end;
}

.picker-sheet {
  width: 100%;
  background: #fbfaf6;
  border-radius: 20rpx 20rpx 0 0;
  padding: 24rpx 0 60rpx;
}

.picker-item {
  text-align: center;
  line-height: 80rpx;
  font-size: 30rpx;
  color: #32423b;
}

.picker-cancel {
  text-align: center;
  color: #8b968f;
  font-size: 30rpx;
  padding: 24rpx;
  /* 分隔线去掉，简约风格 */
  border-top: none;
}

/* === 自定义分类弹窗 === */
.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(50, 66, 59, 0.3);
  z-index: 1001;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease-out;
}

.dialog-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.dialog {
  width: 560rpx;
  background: #fbfaf6;
  border-radius: 20rpx;
  padding: 48rpx 40rpx;
  transform: scale(0.95);
  transition: transform 0.2s ease-out;
}

.dialog-mask.show .dialog {
  transform: scale(1);
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 36rpx;
  color: #32423b;
}

.dialog-input {
  background: #f0f2ec;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  color: #32423b;
  margin-bottom: 36rpx;
  width: 100%;
  box-sizing: border-box;
  line-height: normal;
  height: 80rpx;
}

.dialog-input::placeholder {
  color: #9da79f;
}

.dialog-btns {
  display: flex;
  gap: 20rpx;
}

.dialog-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 100rpx;
  font-size: 30rpx;
}

.dialog-btn.cancel {
  background: #ffffff;
  border: 1.5rpx solid #e8ebe4;
  color: #8b968f;
}

.dialog-btn.confirm {
  background: #466957;
  color: #ffffff;
}

/* 两个操作按钮 */
.action-area {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 56rpx;
  padding: 32rpx 0 16rpx;
}

.action-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 默认隐藏 */
  transform: scale(0);
  opacity: 0;
  transition: transform 0.22s ease-out, opacity 0.18s ease;
}

.action-icon {
  font-size: 36rpx;
  font-weight: bold;
  line-height: 1;
}

/* 取消按钮：红色 */
.cancel-btn {
  background: #e54d42;
}

.cancel-btn .action-icon {
  color: #ffffff;
}

/* 保存按钮：绿色 */
.save-btn {
  background: #466957;
}

.save-btn .action-icon {
  color: #ffffff;
}

/* 弹层打开时：✓ 和 ✕ 展开 */
.panel-open .cancel-btn,
.panel-open .save-btn {
  transform: scale(1);
  opacity: 1;
  transition: transform 0.22s ease-out, opacity 0.18s ease;
}

/* === Emoji 选择弹窗 === */
.emoji-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(50, 66, 59, 0.3);
  z-index: 1001;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
}

.emoji-picker-mask.mask-in {
  animation: mask-fade-in 200ms ease-out forwards;
}

@keyframes mask-fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.emoji-dialog {
  width: 560rpx;
  background: #fbfaf6;
  border-radius: 20rpx;
  padding: 40rpx 36rpx 36rpx;
  opacity: 0;
  transform: scale(0.96);
}

.emoji-dialog.dialog-in {
  animation: dialog-scale-in 240ms ease-out 20ms forwards;
}

@keyframes dialog-scale-in {
  from { opacity: 0; transform: scale(0.96); }
  to   { opacity: 1; transform: scale(1); }
}

.emoji-dialog-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 36rpx;
  color: #32423b;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: center;
}

.emoji-option {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  border-radius: 16rpx;
  transition: background 0.15s;
}

.emoji-option.active {
  background: #dceadf;
}

.emoji-dialog-cancel {
  text-align: center;
  color: #8b968f;
  font-size: 30rpx;
  padding: 28rpx 0 8rpx;
  margin-top: 20rpx;
  /* 分隔线去掉，简约风格 */
  border-top: none;
}
