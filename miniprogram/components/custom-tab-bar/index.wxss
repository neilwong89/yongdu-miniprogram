/* custom-tab-bar 样式 - 清新淡雅 */
.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 96rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #faf8f4;
  display: flex;
  align-items: flex-end;
  border-top: 1.5rpx solid #e4e0d8;
  z-index: 999;
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
}

.tab-text text {
  font-size: 24rpx;
  color: #9e9a93;
  transition: color 0.2s;
  letter-spacing: 0.5rpx;
}

.tab.active .tab-text text {
  color: #4a5a3a;
  font-weight: 600;
}

.tab-center {
  width: 96rpx;
  height: 64rpx;
  background: #6b7c5e;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.center-icon {
  font-size: 40rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}
